  "components": {
    "schemas": {
      "AuthResponse": {
        "properties": {
          "token": {
            "type": "string",
            "title": "Token"
          },
          "user": {
            "$ref": "#/components/schemas/UserRead"
          }
        },
        "type": "object",
        "required": [
          "token",
          "user"
        ],
        "title": "AuthResponse",
        "description": "Wire shape matching iOS `AuthResponse` ({ token, user })."
      },
      "CommitmentDuration": {
        "type": "string",
        "enum": [
          "under_2",
          "three_to_six",
          "seven_to_nine",
          "continuous"
        ],
        "title": "CommitmentDuration",
        "description": "Expected length of commitment in months, as filter buckets (wire values\nmatch iOS CommitmentDuration)."
      },
      "CommitmentFrequency": {
        "type": "string",
        "enum": [
          "weekly",
          "monthly"
        ],
        "title": "CommitmentFrequency",
        "description": "How often a program expects volunteers to show up (wire values match iOS)."
      },
      "ForumCommentRead": {
        "properties": {
          "comment_id": {
            "type": "integer",
            "title": "Comment Id"
          },
          "post_id": {
            "type": "integer",
            "title": "Post Id"
          },
          "author_user_id": {
            "type": "integer",
            "title": "Author User Id"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "comment_id",
          "post_id",
          "author_user_id",
          "body",
          "created_at"
        ],
        "title": "ForumCommentRead",
        "description": "Wire shape matching iOS `ForumComment`."
      },
      "ForumPostRead": {
        "properties": {
          "post_id": {
            "type": "integer",
            "title": "Post Id"
          },
          "program_id": {
            "type": "integer",
            "title": "Program Id"
          },
          "author_user_id": {
            "type": "integer",
            "title": "Author User Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "body": {
            "type": "string",
            "title": "Body"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "post_id",
          "program_id",
          "author_user_id",
          "title",
          "body",
          "created_at"
        ],
        "title": "ForumPostRead",
        "description": "Wire shape matching iOS `ForumPost`."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "degraded",
              "unhealthy"
            ],
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version",
            "default": "0.1.0"
          },
          "services": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ServiceStatus"
            },
            "type": "object",
            "title": "Services"
          }
        },
        "type": "object",
        "required": [
          "status",
          "services"
        ],
        "title": "HealthResponse",
        "description": "Health check response with detailed service statuses."
      },
      "KeywordRead": {
        "properties": {
          "keyword_id": {
            "type": "integer",
            "title": "Keyword Id"
          },
          "category_id": {
            "type": "integer",
            "title": "Category Id"
          },
          "keyword_name": {
            "type": "string",
            "title": "Keyword Name"
          }
        },
        "type": "object",
        "required": [
          "keyword_id",
          "category_id",
          "keyword_name"
        ],
        "title": "KeywordRead",
        "description": "Wire shape matching iOS `Keyword`."
      },
      "LocationRead": {
        "properties": {
          "location_id": {
            "type": "integer",
            "title": "Location Id"
          },
          "city": {
            "type": "string",
            "title": "City"
          },
          "state_region": {
            "title": "State Region",
            "nullable": true,
            "type": "string"
          },
          "country": {
            "type": "string",
            "title": "Country"
          },
          "latitude": {
            "title": "Latitude",
            "nullable": true,
            "type": "number"
          },
          "longitude": {
            "title": "Longitude",
            "nullable": true,
            "type": "number"
          }
        },
        "type": "object",
        "required": [
          "location_id",
          "city",
          "country"
        ],
        "title": "LocationRead",
        "description": "Wire shape matching iOS `Location`."
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 72,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "description": "Wire shape matching iOS `LoginRequest`."
      },
      "ProgramCategoryRead": {
        "properties": {
          "category_id": {
            "type": "integer",
            "title": "Category Id"
          },
          "category_name": {
            "type": "string",
            "title": "Category Name"
          }
        },
        "type": "object",
        "required": [
          "category_id",
          "category_name"
        ],
        "title": "ProgramCategoryRead",
        "description": "Wire shape matching iOS `ProgramCategory`."
      },
      "ProgramCreate": {
        "properties": {
          "category_id": {
            "type": "integer",
            "title": "Category Id"
          },
          "program_name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Program Name"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "title": "Description"
          },
          "start_datetime": {
            "type": "string",
            "format": "date-time",
            "title": "Start Datetime"
          },
          "end_datetime": {
            "type": "string",
            "format": "date-time",
            "title": "End Datetime"
          },
          "max_volunteers": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Max Volunteers"
          },
          "commitment_frequency": {
            "nullable": true,
