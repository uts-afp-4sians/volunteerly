    "/programs": {
      "get": {
        "tags": [
          "programs"
        ],
        "summary": "List Programs",
        "description": "List non-deleted programs, optionally narrowed by query-string filters.\nRepeated params (``team_size``, ``commitment_frequency``,\n``commitment_duration``) are OR-ed within a group and AND-ed across groups.",
        "operationId": "list_programs_programs_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "description": "Search in name/description",
              "title": "Q",
              "nullable": true,
              "type": "string"
            },
            "description": "Search in name/description"
          },
          {
            "name": "category_id",
            "in": "query",
            "required": false,
            "schema": {
              "title": "Category Id",
              "nullable": true,
              "type": "integer"
            }
          },
          {
            "name": "team_size",
            "in": "query",
            "required": false,
            "schema": {
              "title": "Team Size",
              "nullable": true,
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/TeamSize"
              }
            }
          },
          {
            "name": "commitment_frequency",
            "in": "query",
            "required": false,
            "schema": {
              "title": "Commitment Frequency",
              "nullable": true,
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/CommitmentFrequency"
              }
            }
          },
          {
            "name": "commitment_duration",
            "in": "query",
            "required": false,
            "schema": {
              "title": "Commitment Duration",
              "nullable": true,
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/CommitmentDuration"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProgramRead"
                  },
                  "title": "Response List Programs Programs Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
