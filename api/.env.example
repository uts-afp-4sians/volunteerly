# Project
PROJECT_NAME=volunteerly-api
PROJECT_ENV=local

# Database
# Local development uses a plain SQLite file (stdlib pysqlite):
DATABASE_URL=sqlite:///./dev.db
#
# Production uses Turso (distributed SQLite over libSQL). Example:
# DATABASE_URL=sqlite+libsql://your-db-name.turso.io/?authToken=YOUR_TOKEN&secure=true

# CORS (origins allowed to call the API)
CORS_ORIGINS=["http://localhost:3000"]

# Auth / JWT
# Production MUST set a long random secret, e.g. `openssl rand -hex 32`.
JWT_SECRET=dev-insecure-change-me-0000000000-not-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
